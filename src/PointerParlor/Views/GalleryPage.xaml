<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PointerParlor.Views.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PointerParlor.ViewModels"
    xmlns:controls="using:PointerParlor.Controls"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedSets" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="24,12,24,0" RowSpacing="12" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Gallery" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Choose a set to see its pointers. Drop .cur, .ani, .inf or .zip files here to import them." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="260" VerticalAlignment="Center" PlaceholderText="Search sets" QueryIcon="Find" TextChanged="OnSearchChanged" />
            <DropDownButton Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Import">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                    <TextBlock Text="Import" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="Import files…" Click="OnImportFiles" />
                        <MenuFlyoutItem Text="Import a folder…" Click="OnImportFolder" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <GridView
            x:Name="SetsGrid"
            Grid.Row="1"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="OnSetClicked"
            Padding="0,0,0,24">
            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:SetGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:SetCard">
                    <Grid
                        Width="236"
                        Height="168"
                        Padding="12"
                        RowSpacing="10"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind Name}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="6" Background="{ThemeResource PreviewTileBrush}">
                            <ItemsControl ItemsSource="{x:Bind Previews}" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="16" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PreviewItem">
                                        <controls:CursorPreview Path="{x:Bind Path}" DisplaySize="32" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Visibility="{x:Bind ActiveVisibility}" Background="{StaticResource ParlorCoralBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Top">
                                <TextBlock Text="In use" FontSize="12" Foreground="{StaticResource ParlorOnCoralBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="EmptyState" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
            <TextBlock Text="No sets match your search" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Try a different name, or import a cursor set from a .zip, .inf or folder." TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="False" Width="48" Height="48" />
    </Grid>
</Page>
