<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PointerParlor.Views.SetDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PointerParlor.ViewModels"
    xmlns:controls="using:PointerParlor.Controls">

    <Grid Padding="24,12,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SetName" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="SetInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <HyperlinkButton x:Name="SourceLink" Padding="0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RenameButton" Content="Rename…" Click="OnRename" />
                <Button x:Name="DeleteButton" Content="Delete…" Click="OnDelete" />
                <Button x:Name="ApplySetButton" Style="{StaticResource AccentButtonStyle}" Click="OnApplySet">
                    <TextBlock x:Name="ApplySetText" Text="Apply set" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="SizeWarning" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Warning" Title="May look blurry at your pointer size" />

        <GridView x:Name="Tiles" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False" Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:RoleTile">
                    <Grid
                        Width="200"
                        Padding="12"
                        RowSpacing="8"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        AutomationProperties.Name="{x:Bind DisplayName}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="88" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border CornerRadius="6" Background="{ThemeResource PreviewTileBrush}">
                            <Grid>
                                <controls:CursorPreview Path="{x:Bind Path}" DisplaySize="48" Animate="True" Visibility="{x:Bind PreviewVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Windows default" Visibility="{x:Bind MissingVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="2" HorizontalAlignment="Stretch" Command="{x:Bind Command}" Content="{x:Bind ApplyLabel, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
