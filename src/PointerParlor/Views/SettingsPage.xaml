<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PointerParlor.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="Pointer size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="The same setting as Windows Settings › Accessibility › Mouse pointer and touch. Sets with large images stay sharp; others are stretched." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SizeSlider" Minimum="1" Maximum="15" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" ValueChanged="OnSizeChanged" AutomationProperties.Name="Pointer size" />
                    <TextBlock x:Name="SizeLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButtons x:Name="ThemeChoices" SelectionChanged="OnThemeChanged" MaxColumns="3">
                    <x:String>Use Windows setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </RadioButtons>
            </StackPanel>

            <StackPanel Spacing="8" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="Windows default cursors" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Put back the standard Windows pointers. Your sets stay in the gallery, and Undo can bring back what you had." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Reset to Windows default" Click="OnReset" />
            </StackPanel>

            <StackPanel Spacing="8" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Text="Free and open source under the MIT license. No account, no network access, no telemetry." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton Content="github.com/SeanShaffer88/PointerParlor" NavigateUri="https://github.com/SeanShaffer88/PointerParlor" Padding="0" />
                <Button Content="Open the library folder" Click="OnOpenLibrary" />
                <Expander Header="Third-party notices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock x:Name="NoticesText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
