<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 shell, unpackaged and self-contained. All testable logic lives in PointerParlor.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PointerParlor</RootNamespace>
    <AssemblyName>PointerParlor</AssemblyName>
    <Description>A gallery of mouse cursors for Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PointerParlor.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Self-contained builds need a runtime; follow the platform, defaulting to x64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- English-only UI: skip the per-culture satellite folders the runtime would otherwise add. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The shell is only built on Windows CI, so a new SDK warning must not block a release build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PointerParlor.Core\PointerParlor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Raw markup for XamlDiagnostics, which re-parses it when a smoke test hits a XAML load failure. -->
    <EmbeddedResource Include="MainWindow.xaml" LogicalName="Xaml.MainWindow.xaml" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sets shipped with the app; copied into the user's library on first run. -->
    <Content Include="..\..\sets\**" LinkBase="Sets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
