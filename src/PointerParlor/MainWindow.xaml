<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PointerParlor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PointerParlor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="PointerParlor" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="1" Margin="16,0,16,8" IsOpen="False" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            PaneDisplayMode="LeftCompact"
            IsSettingsVisible="True"
            IsBackButtonVisible="Auto"
            BackRequested="OnBackRequested"
            ItemInvoked="OnNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Gallery" Tag="gallery" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
        </NavigationView>

        <Border Grid.Row="3" Background="{ThemeResource StatusBarBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource ParlorCoralBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SaveMixButton" Grid.Column="2" Content="Save mix…" Click="OnSaveMix" Visibility="Collapsed" />
                <Button x:Name="UndoButton" Grid.Column="3" Click="OnUndo" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        <TextBlock x:Name="UndoText" Text="Undo" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
