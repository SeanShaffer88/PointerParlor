<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PointerParlor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Fanned Set palette: teal accent, coral and gold highlights. -->
            <Color x:Key="SystemAccentColor">#1F5563</Color>
            <Color x:Key="SystemAccentColorLight1">#2C6E7E</Color>
            <Color x:Key="SystemAccentColorLight2">#5FB3C4</Color>
            <Color x:Key="SystemAccentColorLight3">#9AD8E2</Color>
            <Color x:Key="SystemAccentColorDark1">#1F5563</Color>
            <Color x:Key="SystemAccentColorDark2">#163F4A</Color>
            <Color x:Key="SystemAccentColorDark3">#0F2A33</Color>

            <SolidColorBrush x:Key="ParlorCoralBrush" Color="#FF7A59" />
            <SolidColorBrush x:Key="ParlorGoldBrush" Color="#F5C04A" />
            <SolidColorBrush x:Key="ParlorOnCoralBrush" Color="#2A0E06" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PreviewTileBrush" Color="#EEF4F5" />
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#F7FAFA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PreviewTileBrush" Color="#1A2B30" />
                    <SolidColorBrush x:Key="StatusBarBrush" Color="#16252A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PreviewTileBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StatusBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
